# --- Postgres connection ---
# Any free Postgres host works: Neon, Supabase, Railway, Render, Aiven, etc.
# Neon example: postgresql://user:pass@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# --- App config ---
PORT=4000
# Generate a strong random string for signing JWTs (e.g. `openssl rand -hex 32`)
JWT_SECRET=change-me-to-a-long-random-string
# Token lifetime
JWT_EXPIRES_IN=7d
# CORS: comma-separated list of allowed origins for the frontend
CORS_ORIGIN=http://localhost:5173,http://localhost:8080

# --- Seed / bootstrap ---
# Runs on `npm run migrate`. Set to false after first deploy.
SEED_ON_MIGRATE=true
# The first developer account created if the DB is empty
BOOTSTRAP_DEV_USER=developer
BOOTSTRAP_DEV_PASS=devpass
